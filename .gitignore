models/
*.ckpt
*.pt
*.bin
*.safetensors

# Audio captures (samples/ is tracked; ad-hoc recordings are not)
recordings/
*.wav
*.flac
!samples/*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

